# ---------------------------------------------------------------------
# Experiences El Salvador — variables de entorno
# `pnpm bootstrap` copia este archivo a .env y genera AUTH_SECRET.
# Nunca subir secretos al repositorio.
# ---------------------------------------------------------------------

# --- BASE DE DATOS ---------------------------------------------------
# PostgreSQL en Neon. En desarrollo usa la rama "development" de Neon,
# NUNCA la de produccion (production vive solo en Netlify y en
# .env.production.local). Neon → Connect → elige la rama.
#   DATABASE_URL  cadena CON pooler (host "-pooler")
#   DIRECT_URL    cadena SIN pooler (la usan las migraciones)
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/experiences?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/experiences?sslmode=require"
#
# Solo para `pnpm test`: base EXCLUSIVA de pruebas (rama "test" en Neon).
# Las pruebas de pagos y beneficios BORRAN datos; sin esta variable se omiten.
# TEST_DATABASE_URL="postgresql://..."

# --- AUTENTICACION ---------------------------------------------------
# Obligatorio. Generar con: openssl rand -base64 32
AUTH_SECRET=

# En produccion, la URL publica del sitio.
# AUTH_URL=https://tu-dominio.com
AUTH_TRUST_HOST=true

# --- OAUTH (opcional) ------------------------------------------------
# Si faltan, el boton correspondiente NO aparece en la interfaz.
# Instrucciones completas en docs/OAUTH.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Instagram y TikTok: no implementados. Ninguna de las dos plataformas
# entrega el correo del usuario, que es la clave con la que este sistema
# identifica cuentas y evita que alguien obtenga el 25% varias veces.
# Ver docs/OAUTH.md antes de intentarlo.

# --- OPINIONES DE GOOGLE (opcional) ----------------------------------
# Places API (New). Devuelve un MAXIMO DE 5 RESENAS, sin paginacion.
# Sin prefijo NEXT_PUBLIC_: la clave se queda en el servidor.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- URL PUBLICA -----------------------------------------------------
# Para enlaces absolutos: retorno y webhook de Wompi, QR de las entradas y
# correos. En Netlify, si falta, se usa la variable URL que pone Netlify.
# SITE_URL=https://tu-dominio.com

# --- COTIZACION POR CORREO -------------------------------------------
# Correo publico al que llegan las cotizaciones de los servicios de
# conductor (Driver by Tour y Personal Driver). Lleva prefijo
# NEXT_PUBLIC_ porque el boton se construye en el navegador.
# SIN esta variable el boton de correo no se muestra: solo WhatsApp.
# NEXT_PUBLIC_QUOTE_EMAIL=reservas@tu-dominio.com

# --- BUSCADORES ------------------------------------------------------
# Codigo de verificacion de Google Search Console (metodo «etiqueta HTML»).
# Pegar SOLO el valor del atributo content, sin la etiqueta entera.
# Sin esta variable no se escribe ninguna etiqueta. Guia en docs/SEO.md
# GOOGLE_SITE_VERIFICATION=

# --- PAGOS: WOMPI EL SALVADOR ----------------------------------------
# Todo en el SERVIDOR: ninguna lleva NEXT_PUBLIC_. Guía en docs/WOMPI.md
# Comprueba las credenciales con: pnpm wompi:check
#
# WOMPI_ENVIRONMENT
#   mock        pasarela simulada, sin credenciales (por defecto en desarrollo)
#   sandbox     Wompi real con el negocio en modo de pruebas: no cobra
#   production  cobro real; rechaza transacciones de prueba
# Sin definir en producción → los pagos quedan DESACTIVADOS (nunca mock).
WOMPI_ENVIRONMENT=mock
#
# Panel de Wompi → Configuración → Integraciones (aplicativo):
#   WOMPI_PUBLIC_KEY  = App ID      (client_id)
#   WOMPI_PRIVATE_KEY = API Secret  (client_secret)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Clave con la que Wompi firma el webhook (cabecera wompi_hash). Wompi usa
# el API Secret: si se deja vacía, se usa WOMPI_PRIVATE_KEY.
WOMPI_WEBHOOK_SECRET=
# Opcional: correos del comercio que Wompi avisa en cada pago (separados por coma).
# WOMPI_NOTIFY_EMAILS=reservas@tu-dominio.com

# --- PAGOS: PAYPAL ---------------------------------------------------
# PayPal se AÑADE a Wompi, no lo sustituye. Las dos se configuran por
# separado: el comprador elige entre las que estén disponibles. Si estas
# variables faltan, PayPal simplemente no aparece como opcion de pago.
# Guia completa en docs/PAYPAL.md
#
# PAYPAL_ENVIRONMENT
#   sandbox     cuentas de prueba de developer.paypal.com; no cobra
#   production  cobro real (tambien se acepta el valor "live")
# PAYPAL_ENVIRONMENT=sandbox
#
# Panel de PayPal -> Apps & Credentials:
#   PAYPAL_CLIENT_ID     = Client ID
#   PAYPAL_CLIENT_SECRET = Secret
# Ninguna lleva NEXT_PUBLIC_: las dos se quedan en el servidor.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- ADMINISTRACION --------------------------------------------------
# Cuenta que puede entrar en /admin. Se aplica con: pnpm admin:setup
# La contrasena NO se guarda en claro: el script la convierte en un hash
# bcrypt, igual que las del resto de cuentas. Nunca subir valores reales.
# Generar una con: openssl rand -base64 24
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME="Administracion"

# --- ENTRADAS --------------------------------------------------------
# Clave del personal para marcar entradas como USADAS al escanear el QR.
# Sin ella, las entradas se pueden consultar pero no validar.
# Generar con: openssl rand -base64 24
TICKET_VALIDATION_KEY=

# --- CORREO (Resend) -------------------------------------------------
# Sin estas dos, la reserva se confirma igual pero no se envía el correo.
# EMAIL_FROM debe ser un remitente de un dominio verificado en Resend.
RESEND_API_KEY=
# EMAIL_FROM="Experiences El Salvador <reservas@tu-dominio.com>"
